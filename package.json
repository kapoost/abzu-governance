{
  "name": "@kapoost/abzu-governance",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Abzu governance agent — sync_plans / check_governance / report_plan_outcome / get_plan_audit_logs",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target bun"
  },
  "dependencies": {
    "@adcp/sdk": "13.0.0-rc.13",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
